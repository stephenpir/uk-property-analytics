{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ListPropertyAnalyticsBucket",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket"
            ],
            "Resource": "arn:aws:s3:::spir23-uk-residential-property-analytics-dev"
        },
        {
            "Sid": "ReadPropertyAnalyticsObjects",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject"
            ],
            "Resource": "arn:aws:s3:::spir23-uk-residential-property-analytics-dev/landing/land-registry/*"
        }
    ]
}